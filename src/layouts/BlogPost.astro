---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '@components/layout/BaseHead.astro';
import Footer from '@components/layout/Footer.astro';
import FormattedDate from '@components/utils/FormattedDate.astro';
import Header from '@components/layout/Header.astro';
import Series from '@components/blog/SeriesProgress.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_URL } from '@consts';

const { id, title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;

const series = await getCollection('series');
const allPosts = await getCollection('blog');

const currentSeries = series.find(s => s.data.posts.includes(id));
const index = currentSeries ? currentSeries.data.posts.indexOf(id) : -1;
const total = currentSeries ? currentSeries.data.posts.length : 1;
const publishedPosts = allPosts
	.filter(post => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = publishedPosts.findIndex(post => post.id === id);
const previousPost = currentIndex < publishedPosts.length - 1 ? publishedPosts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? publishedPosts[currentIndex - 1] : undefined;
const currentTags = new Set(tags || []);
const relatedPosts = publishedPosts
	.filter(post => post.id !== id)
	.map(post => ({
		post,
		score: (post.data.tags || []).reduce((score, tag) => score + (currentTags.has(tag) ? 1 : 0), 0),
	}))
	.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
	.slice(0, 2)
	.map(({ post }) => post);
const articleStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: pubDate?.toISOString(),
	dateModified: updatedDate?.toISOString() || pubDate?.toISOString(),
	mainEntityOfPage: `${SITE_URL}/blog/${id}/`,
	author: { '@type': 'Person', name: SITE_TITLE, url: SITE_URL },
};

---

<html lang="en">
	<head>
		<BaseHead 
			title={title}
			description={description}
			image={heroImage}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
		<style>
			main { max-width: var(--max-width-wide); margin: 0 auto; }
			.hero-image { width: 100%; max-width: 860px; margin: 0 auto; }
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-sm);
				background-color: var(--color-image-bg);
				max-height: 400px;
				max-width: 720px;
				min-width: 0;
				width: 100%;
				object-fit: contain;
			}
			.prose {
				width: var(--max-width-content);
				max-width: 100%;
				min-width: 0;
				margin: auto;
				padding: clamp(var(--space-md), 4vw, var(--space-xl)) var(--space-md) var(--space-2xl);
				color: var(--color-text);
			}
			.title {
				margin: var(--space-xl) 0 var(--space-lg);
			}
			.title h1 {
				max-width: 760px;
				margin: 0 0 var(--space-md);
				font-size: clamp(2.25rem, 5vw, var(--font-size-5xl));
				line-height: 1.05;
			}
			.date {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-sm);
				margin-bottom: var(--space-md);
				color: var(--color-text-secondary);
				font-size: var(--font-size-sm);
			}
			.last-updated-on {
				font-style: italic;
			}
			.summary { max-width: 650px; color: var(--color-text-secondary); font-size: var(--font-size-lg); margin-bottom: var(--space-md); }
			.tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-lg); }
			.tag { padding: 0.25rem 0.6rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-secondary); font-size: var(--font-size-xs); }
			.related { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
			.related h2 { font-size: var(--font-size-2xl); margin: 0 0 var(--space-md); }
			.related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
			.related-card { display: block; padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: inherit; text-decoration: none; }
			.related-card:hover { border-color: var(--color-accent); text-decoration: none; }
			.related-card strong { display: block; margin-bottom: var(--space-xs); }
			.related-card span { color: var(--color-text-secondary); font-size: var(--font-size-sm); }
			.article-nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); margin-top: var(--space-2xl); }
			.article-nav a { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: inherit; text-decoration: none; }
			.article-nav a:hover { border-color: var(--color-accent); text-decoration: none; }
			.article-nav .label { color: var(--color-text-secondary); font-family: var(--font-sans); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); letter-spacing: 0.06em; text-transform: uppercase; }
			.article-nav .next { text-align: right; }

			@media (max-width: 900px) {
				.prose {
					width: 100%;
				}
			}
			@media (max-width: 640px) { .related-grid, .article-nav { grid-template-columns: 1fr; } .article-nav .next { text-align: left; } }
		</style>
	</head>

	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<Header />
		<main id="main-content" tabindex="-1">
			<article>
				<div class="prose">
					<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={`Illustration for ${title}`} />}
				</div>
					<div class="title">
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{description && <p class="summary">{description}</p>}
						{tags?.length && <div class="tags" aria-label="Topics">{tags.map(tag => <span class="tag">{tag}</span>)}</div>}
						<hr />
					</div>
					{currentSeries && (
						<Series 
							series={currentSeries.data}
							index={index} 
							total={total} 
						/>
					)}
					<slot />
					{(previousPost || nextPost) && (
						<nav class="article-nav" aria-label="Article navigation">
							{previousPost ? <a href={`/blog/${previousPost.id}/`} data-umami-event="click-article-navigation" data-umami-event-direction="previous"><span class="label">← Previous article</span><strong>{previousPost.data.title}</strong></a> : <span />}
							{nextPost ? <a class="next" href={`/blog/${nextPost.id}/`} data-umami-event="click-article-navigation" data-umami-event-direction="next"><span class="label">Next article →</span><strong>{nextPost.data.title}</strong></a> : <span />}
						</nav>
					)}
					{relatedPosts.length > 0 && (
						<section class="related" aria-labelledby="related-title">
							<h2 id="related-title">Keep reading</h2>
							<div class="related-grid">
								{relatedPosts.map(post => (
									<a class="related-card" href={`/blog/${post.id}/`} data-umami-event="click-related-post">
										<strong>{post.data.title}</strong>
										<span>{post.data.description || 'Read the article'} <span aria-hidden="true">↗</span></span>
									</a>
								))}
							</div>
						</section>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
