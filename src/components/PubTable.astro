---
import { getCollection } from 'astro:content';

const publications = await getCollection('publications');
---

{
	publications.map((pub) => (
		<>
			<i>
				<b>{pub.data.title}</b>
			</i>

			<br />
			{pub.data.authors.map((author, idx) => (
				<>
					{author}
					{idx < pub.data.authors.length - 1 && ','}
				</>
			))}

			<br />

			{/* Links */}
			<span class="publication-links">
				{pub.data.poster && (
					<a target="_blank" rel="noreferrer" href={pub.data.poster} aria-label={`View poster for ${pub.data.title}`} data-umami-event="click-publication" data-umami-event-publication={pub.data.title} data-umami-event-format="poster">
						poster
					</a>
				)}
				&nbsp;
				{pub.data.pdf && (
					<a target="_blank" rel="noreferrer" href={pub.data.pdf} aria-label={`Read paper ${pub.data.title}`} data-umami-event="click-publication" data-umami-event-publication={pub.data.title} data-umami-event-format="pdf">
						pdf
					</a>
				)}
				&nbsp;
				{pub.data.doi && (
					<a target="_blank" rel="noreferrer" href={`https://doi.org/${pub.data.doi}`} aria-label={`Open DOI for ${pub.data.title}`} data-umami-event="click-publication" data-umami-event-publication={pub.data.title} data-umami-event-format="doi">
						link
					</a>
				)}
			</span>

			<br />
			<br />
		</>
	))
}

<style>
	.publication-links {
		display: flex;
		justify-content: flex-end;
		gap: var(--space-sm);
		margin-top: var(--space-sm);
	}
</style>
