---
import avatarImage from '@assets/avatar_real.webp';
import { SITE_TITLE } from '@consts';

const title="Hi, I’m Marco.";
const subtitle = "I work across frontend, backend, and infrastructure, with a growing interest in software architecture and distributed systems.";
---

<section class="hero" data-hero>
	<div class="hero-inner">
		<div class="avatar-wrapper">
			<img src={avatarImage.src} alt="Portrait of Marco Bacis" class="avatar" />
		</div>
		<div class="hero-content">
		<p class="eyebrow">Software engineer · learning in public</p>
		<h1>{title}</h1>
		{subtitle && <p class="hero-sub">{subtitle}</p>}
		<div class="hero-actions">
			<a class="button button-primary" href="/about">About me <span aria-hidden="true">↗</span></a>
			<a class="button button-secondary" href="/blog">Read the blog <span aria-hidden="true">↗</span></a>
		</div>
		<p class="hero-focus">This site is a collection of my notes, projects, and things I’m currently learning.</p>
		</div>
	</div>
</section>

<style>
	[data-hero] {
		padding: clamp(var(--space-md), 5vw, var(--space-xl)) 0 clamp(var(--space-xl), 8vw, var(--space-2xl));
		text-align: left;
	}

	.hero {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-inner {
		max-width: var(--max-width-content);
		display: flex;
		align-items: center;
		gap: clamp(var(--space-lg), 7vw, var(--space-2xl));
		width: 100%;
	}

	.avatar-wrapper {
		flex-shrink: 0;
	}

	.avatar {
		width: clamp(150px, 23vw, 260px);
		height: clamp(150px, 23vw, 260px);
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--color-accent);
		box-shadow: 10px 10px 0 color-mix(in srgb, var(--color-accent) 9%, transparent);
		display: block;
	}

	[data-hero] h1 {
		max-width: 700px;
		font-size: clamp(2.35rem, 5.5vw, var(--font-size-5xl));
		line-height: 1.02;
		margin-bottom: var(--space-md);
	}

	.eyebrow {
		color: var(--color-accent);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: var(--space-md);
	}

	.hero-sub {
		color: var(--color-text-secondary);
		max-width: 620px;
		font-size: clamp(var(--font-size-lg), 2.2vw, var(--font-size-xl));
		margin-bottom: var(--space-md);
	}

	.hero-focus {
		color: var(--color-text-secondary);
		max-width: 600px;
		font-size: var(--font-size-sm);
		margin-top: var(--space-lg);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);
		padding: 0.7rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
		transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
	}

	.button:hover {
		text-decoration: none;
		transform: translateY(-1px);
	}

	.button-primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: white;
	}

	.button-primary:hover {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
		color: white;
	}

	.button-secondary {
		background: var(--color-surface);
		color: var(--color-text);
	}

	.button-secondary:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	@media (max-width: 640px) {
		.hero-inner {
			flex-direction: column;
			text-align: center;
		}

		.hero-content {
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.hero-focus {
			text-align: center;
		}
	}
</style>
